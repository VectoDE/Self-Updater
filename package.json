{
  "name": "@vectode/self-updater",
  "version": "4.2.1",
  "description": "Keeps a server checkout in sync with its Git repository: deploys new commits or release tags, restarts PM2, Docker, Compose or systemd services, checks health and rolls back on failure. Polling or webhooks, no runtime dependencies.",
  "keywords": [
    "deploy",
    "auto-update",
    "self-updater",
    "gitops",
    "continuous-deployment",
    "pm2",
    "docker",
    "docker-compose",
    "systemd",
    "webhook",
    "rollback",
    "github",
    "gitlab",
    "cli"
  ],
  "homepage": "https://self-updater.pages.dev/",
  "bugs": {
    "url": "https://github.com/VectoDE/Self-Updater/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VectoDE/Self-Updater.git"
  },
  "license": "Apache-2.0",
  "author": "Vecto (https://github.com/VectoDE)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "config": [
        "./dist/config.d.cts"
      ]
    }
  },
  "bin": {
    "self-updater": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsdown",
    "check:package": "publint --strict && attw --pack .",
    "build:site": "node scripts/build-site.mjs",
    "dev:site": "node scripts/build-site.mjs --serve",
    "typecheck": "tsc --noEmit && node node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run check:package",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
